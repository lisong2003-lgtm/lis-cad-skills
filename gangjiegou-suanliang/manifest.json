    "skill": "cad-file-reader>=0.39.2 with packs/steel-geometry; lis-skill-bus>=0.1.9",
    "contract": "cad-contract/v1 through lis-skill-bus",
    "python": ">=3.10",
    "note": "两个技能仅正式识图链路需要；已有 *.steel.json 可直接计算。单独安装本技能不会自动带入前置。"
  },
  "scripts": [
    "scripts/pyboot.py",
    "scripts/runtime_env.sh",
    "scripts/gangjiegou_statesync.py",
    "scripts/gangjiegou_statesync.sh",
    "scripts/gangjiegou_statesync.cmd",
    "scripts/steel_tonnage.py",
    "scripts/steel_tonnage.sh"
  ],
  "references": [
    "CHANGELOG.md",
    "LICENSE.md",
    "README.en.md",
    "README.md",
    "requirements.txt"
  ],
  "tests": [
    "scripts/tests/test_steel_tonnage.py"
  ],
  "privacy": "只在本机消费已有识图契约 JSON；发布包不含 DWG/DXF/PDF、项目数据、公司路径或图纸内容。",
  "notes": "输出为 ±15% 吨位估算带，final_quantity=false；total_t 为推荐口径，分摊值另存 total_t_allocated_estimate；不替代深化设计、翻样、下料、结算与报价。",
  "contract_schema": "cad-steel-geometry/v1 -> cad-steel-tonnage/v0.2",
  "description": "钢结构识图契约 JSON → 牌号分档、构件归并、连接计数、涂装面积、截面谱与吨位估算带（json/md/csv）；逐根/分摊双口径、--validate 契约体检、长度敏感性场景；支持 GB/T 706 号数型槽钢/工字钢查表与两档长度口径。",
  "platforms": [
    "macos",
    "windows",
    "linux"
  ],
  "examples": [
    "examples/minimal.steel.json",
    "examples/README.md"
  ]
